#device					       mount point             fstype   [device2] [length=]
/dev/block/bootdevice/by-name/cache            /cache                   ext4    nosuid,noatime,nodev,barrier=1                       wait
/dev/block/bootdevice/by-name/userdata         /data                    f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt             latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+emmc_optimized,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption,readahead_size_kb=128,checkpoint=fs
/dev/block/by-name/metadata                    /metadata                ext4    noatime,nosuid,nodev,discard                         wait,formattable,first_stage_mount
/dev/block/bootdevice/by-name/misc             /misc                    emmc    defaults                                                             defaults

system						/system			ext4	rw								wait,logical,first_stage_mount
system_ext					/system_ext		ext4	rw								wait,logical,first_stage_mount
product						/product		ext4	rw								wait,logical,first_stage_mount
vendor						/vendor			ext4	rw								wait,logical,first_stage_mount
odm						/odm			ext4	rw								wait,logical,first_stage_mount
